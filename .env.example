# apps/web environment (Vercel project, Root Directory = apps/web).
# Names only; never commit values. For local dev copy to apps/web/.env.local and fill in.
# Only the two NEXT_PUBLIC_* values may be used in browser code.

# Supabase (Adrit)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Grok vision (Labib)
XAI_API_KEY=

# Image service on Vultr (Adrit); ANALYZE_SERVICE_KEY must equal SERVICE_KEY in apps/analyze
ANALYZE_URL=
ANALYZE_SERVICE_KEY=

# Tiger Data (Labib)
TIGER_DATABASE_URL=

# Solana devnet (Nihalika)
SOLANA_RPC_URL=
SOLANA_SECRET_KEY=

# Grok vision model override (Labib). Optional: only set if xAI renames the vision model.
XAI_MODEL=

# ElevenLabs (Labib). Local only: the clips are pre-generated and committed, so nothing
# at runtime calls ElevenLabs and this is never set in Vercel.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_ES=
