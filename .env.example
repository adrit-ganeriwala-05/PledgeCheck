# PledgeCheck environment variables. Names only, never values.
# Secrets live in Vercel and on the Vultr instance.

# --- Supabase: system of record (Adrit) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- xAI Grok vision: first reader, SpaceXAI prize (Labib) ---
XAI_API_KEY=
# Optional: override if xAI renames the vision model this weekend.
XAI_MODEL=

# --- Vultr image service: second reader, .Tech subdomain (Adrit) ---
ANALYZE_URL=https://api.pledgecheck.tech/analyze
ANALYZE_SERVICE_KEY=
# On the Vultr instance itself, the same shared secret is SERVICE_KEY.

# --- Tiger Data: de-identified warehouse (Labib) ---
TIGER_DATABASE_URL=

# --- Solana devnet: audit anchor (Nihalika) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SECRET_KEY=

# --- ElevenLabs: voice clips (Labib) ---
# Local only. The clips are pre-generated and committed, so nothing at runtime
# calls ElevenLabs and this is never set in Vercel.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_ES=
